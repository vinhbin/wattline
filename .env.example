# Optional — only needed if/when the pipeline writes to Postgres+PostGIS.
# The API itself serves precomputed JSON (data/processed/ -> mocks/) and
# runs with no environment at all.
DATABASE_URL=postgresql://user:pass@host:5432/wattline

